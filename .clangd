CompileFlags:
  # Use the compile_commands.json generated by CMake for the ARM toolchain flags
  CompilationDatabase: build

Diagnostics:
  # Suppress false-positive "file not found" errors that occur because clangd
  # uses the host system headers instead of the ARM cross-compiler's stdlib.
  # These headers (cassert, cstdlib, etc.) exist in the actual toolchain and
  # will not cause real build errors.
  Suppress:
    - pp_file_not_found
    - undeclared_identifier
